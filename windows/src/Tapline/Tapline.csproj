<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Tapline</RootNamespace>
    <AssemblyName>Tapline</AssemblyName>
    <ApplicationIcon>Assets\Tapline.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Tapline</Product>
    <Company>Tapline contributors</Company>
    <Copyright>Copyright © 2026 Tapline contributors. GPL-3.0.</Copyright>
    <Version Condition="'$(Version)' == ''">0.5.0</Version>
    <!-- Equalizer APO only ships for x64, so Tapline does too. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define these; the app only uses WinForms for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tapline.Core\Tapline.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Tapline.ico" />
    <Resource Include="Assets\Tapline-256.png" />
    <!-- The macOS translations, shared: keys are the English source strings. -->
    <EmbeddedResource Include="..\..\..\Tapline\Resources\zh-Hans.lproj\Localizable.strings" LogicalName="zh-Hans.strings" />
    <!-- Windows-only translations, one file per area. -->
    <EmbeddedResource Include="Assets\zh-Hans.*.strings" LogicalName="%(Filename)%(Extension)" />
    <!-- Virtual Speakers' built-in impulse responses (SADIE II, Apache-2.0), shared with macOS. -->
    <EmbeddedResource Include="..\..\..\Tapline\Resources\VirtualSpeakers\*.wav" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
